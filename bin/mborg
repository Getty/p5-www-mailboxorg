    my %args = @_;
    die "Usage: mborg domain set domain=<domain> [password=<pw>] [context_id=<id>] [create_new_context_id=1] [memo=<note>]\n"
        unless $args{domain};
    my $result = $api->domain->set(%args);
    pp($result);
}

